BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
BreakBeforeBraces: Linux
ColumnLimit: 100
AlignConsecutiveMacros: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# Include order: own header, blank line, <system>, blank line, then project
# includes. Within each block, plain headers sort before subdirectory ones.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Winsock must precede windows.h, which otherwise exposes the incompatible Winsock 1 API.
  - Regex: '^<winsock2\.h>$'
    Priority: 1
    SortPriority: 1
  # Windows extension headers depend on types declared by windows.h.
  - Regex: '^<windows\.h>$'
    Priority: 1
    SortPriority: 2
  - Regex: '^<[^/]+>$'
    Priority: 1
    SortPriority: 3
  - Regex: '^<.+/'
    Priority: 1
    SortPriority: 4
  - Regex: '^"[^/]+"$'
    Priority: 2
    SortPriority: 5
  - Regex: '^".+/'
    Priority: 2
    SortPriority: 6
SpaceBeforeParens: ControlStatements
PointerAlignment: Right
