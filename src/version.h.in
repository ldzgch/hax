#ifndef HAX_VERSION_H
#define HAX_VERSION_H

/* Filled in by scripts/build.py at build time: `git describe` output in a
 * checkout (exact tag on releases, tag-distance-hash on dev builds, "+" when
 * dirty), the project version when building without git. */
#define HAX_VERSION "@VCS_TAG@"

#endif
